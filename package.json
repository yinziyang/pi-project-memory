    "docs/current-reader-runtime.md",
    "docs/n05-index-json-boundary.md",
    "docs/n05-index-unconfirmed-lifecycle.md",
    "docs/1.md",
    "docs/project-memory-knowledge-contract.md",
    "docs/remaining-work.md"
